# PostgreSQL (docker-compose: порт 5433, чтобы не конфликтовать с локальным 5432)
DATABASE_URL="postgresql://djinni:djinni@localhost:5433/djinni?schema=public"

# Сторедж сырого HTML (кэш скрейпа): db — таблица RawHtmlPage (общий кэш для
# команды, дефолт), fs — файлы cache/scrape/{list,detail} (офлайн-фолбэк).
# Переезд локальных файлов в БД: pnpm raw:sync
#RAW_STORE=db

# Скрейп: случайная пауза между запросами, мс (равномерно из [MIN, MAX])
SCRAPE_DELAY_MIN_MS=3000
SCRAPE_DELAY_MAX_MS=8000

# TTL кэша:
# - страницы списка: 1 день (инвалидирует ВСЕ страницы — нумерация сдвигается);
# - детали вакансии: 7 дней (плюс принудительный рефетч при изменении datePosted на djinni)
LIST_TTL_DAYS=1
DETAIL_TTL_DAYS=7

# Фильтр списка: категории «Розробка» (djinni primary_keyword, мультивыбор через запятую).
# Дефолт (ниже) даёт ~256 вакансий вместо ~6135 без фильтра; "none" или пустое значение — без фильтра.
# Смена фильтра инвалидирует кэш списка (fingerprint в ListCacheState).
FILTER_PRIMARY_KEYWORDS="JavaScript, Angular, Markup, React.js, Svelte, Vue.js, Fullstack, Node.js, No Code, React Native"

# Честный User-Agent с указанием бота (можно переопределить)
#SCRAPE_USER_AGENT="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36 SkillRadar/0.1 (+github.com/llamerr/djinni-skill-monitor)"

# LLM-слой экстракции навыков (ADR 0002, pnpm extract:llm):
# OpenAI-совместимый фасад — OpenCode Zen / OpenRouter / OpenAI / LM Studio.
# Zen: ключ на https://opencode.ai/auth (или /connect в opencode), есть бесплатные модели.
LLM_ENABLED=0
LLM_BASE_URL=https://opencode.ai/zen/v1
#LLM_API_KEY=
#LLM_MODEL=deepseek-v4-flash-free
#LM Studio (локально): LLM_BASE_URL=http://localhost:1234/v1, LLM_MODEL=<id>, любой непустой ключ
# Порог гейта: вызывать LLM, если после 3 слоёв навыков < N; конкурентность и ретраи
#LLM_EXTRACT_THRESHOLD=1
#LLM_CONCURRENCY=3
#LLM_MAX_ATTEMPTS=2
#LLM_TIMEOUT_MS=60000
# Режим структурированного вывода: 1 → json_schema (LM Studio), 0 → json_object (Zen и др.)
#LLM_STRUCTURED_OUTPUTS=1
